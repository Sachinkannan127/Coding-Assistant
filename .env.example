# ==============================================================================
# AI Code Review & Refactoring Platform - Environment Configuration Example
# Copy this file to '.env' in the project root and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Metadata & Environment Mode
# ------------------------------------------------------------------------------
APP_NAME="AI Code Review & Refactoring Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# ------------------------------------------------------------------------------
# Networking & Security
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8005
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ENABLE_RATE_LIMITING=True
RATE_LIMIT_PER_MINUTE=60
GUEST_USER_ID="guest_user"

# ------------------------------------------------------------------------------
# AI LLM Provider API Keys
# Required for live multi-agent code analysis and refactoring workflows
# ------------------------------------------------------------------------------
# Primary LLM Provider (Google Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=""

# Secondary Fallback LLM Provider (Mistral Large / Codestral)
MISTRAL_API_KEY=""

# ------------------------------------------------------------------------------
# Database & Vector Persistence
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas connection string or local MongoDB instance)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="code_pilot"

# ------------------------------------------------------------------------------
# Observability & Tracing (LangSmith)
# Optional: Set to True and populate key to enable detailed agent trace logs
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=False
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="code-review-platform"

# ------------------------------------------------------------------------------
# Clerk Authentication Configuration
# Optional in development unless REQUIRE_AUTH=True
# ------------------------------------------------------------------------------
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_ISSUER_URL=""
CLERK_JWKS_URL=""
REQUIRE_AUTH=False

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8005"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
